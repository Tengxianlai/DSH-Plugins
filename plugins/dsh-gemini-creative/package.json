{
  "name": "dsh-gemini-creative",
  "version": "0.4.0",
  "private": true,
  "description": "按需加载的创作与审看技能：写剧本/文案、对照场景图与分镜；技术质检路由到本地工具与子代理。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify.mjs"
  }
}
