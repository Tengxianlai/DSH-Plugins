{
  "name": "dsh-share-hub",
  "version": "0.2.0",
  "private": true,
  "description": "会话分享中心：把当前会话发布成只读链接（经既有反代中转），或在本机导出 PDF / HTML / Markdown 后经认证路由下载。",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "license": "MIT"
}
