{
  "name": "dsh-gemini",
  "version": "0.4.0",
  "private": true,
  "description": "Gemini 4 Argon 多模态工具：文学/文字创作与图片/短片综合判断；技术质检留给本地工具与子代理。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3"
  }
}
